<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#117F8B"
                android:centerColor="#2C507E"
                android:endColor="#4B126B"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <inset android:inset="16.666667%">
            <bitmap
                android:src="@drawable/app_icon_artwork"
                android:gravity="fill"
                android:filter="true" />
        </inset>
    </item>
</layer-list>
